name: Unpack ZIP
on: workflow_dispatch
permissions:
  contents: write
jobs:
  unpack:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - name: Unzip project
        run: |
          unzip -o ZYRAX.zip -d /tmp/p
          rm -rf /tmp/p/ZYRAX/.github
          cp -r /tmp/p/ZYRAX/. .
          rm ZYRAX.zip
      - name: Commit
        run: |
          git config user.name "github-actions"
          git config user.email "actions@github.com"
          git add -A
          git commit -m "Add ZYRAX AI project"
          git push
